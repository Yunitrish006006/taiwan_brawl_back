{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taiwan-brawl-api",
	"main": "src/index.js",
	"compatibility_date": "2026-03-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"DATABASE_MODE": "split",
		"ENABLE_COUPLES_API": "true",
		"MAINTENANCE_MODE": "false",
		"GAME_CATALOG_TRUST_KEYS": "{\"catalog-prod-2026-10\":{\"publisher\":\"taiwan-brawl\",\"publicKey\":\"4WyFxNR343aaKu1ccZNpBGg4OQ2D3qH7ekYMAJzFQ1c\"}}"
	},
	"observability": {
		"enabled": true
	},
	"triggers": { "crons": ["* * * * *"] },
	"durable_objects": {
		"bindings": [
			{
				"name": "ROYALE_ROOM",
				"class_name": "RoyaleRoom"
			},
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			},
			{
				"name": "SIGNAL_ROOM",
				"class_name": "SignalRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RoyaleRoom"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"ChatRoom"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"SignalRoom"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "taiwan_brawl_db",
			"database_id": "9a7e86fe-44a9-40aa-8a09-a436db818c87",
			"migrations_dir": "migrations",
			"remote": true
		},
		{
			"binding": "SOCIAL_DB",
			"database_name": "taiwan_brawl_social_db",
			"database_id": "d25f54ae-fc80-47cf-b2cc-8b0cb30272ca",
			"migrations_dir": "migrations/social",
			"remote": true
		},
		{
			"binding": "GAME_DB",
			"database_name": "taiwan_brawl_game_db",
			"database_id": "4e6249ee-3ca9-48f6-9a56-aec432f03c5b",
			"migrations_dir": "migrations/games",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "STATIC_ASSETS",
			"id": "cfea84655a1f4b298bb92466317201b2"
		},
		{
			"binding": "CHAT_SYNC",
			"id": "e03f7c3739f6492287dd13b3fb6429eb"
		},
		{
			"binding": "PUSH_RETRY",
			"id": "310f941d8b714565955556fafb13d76c"
		}
	]
}

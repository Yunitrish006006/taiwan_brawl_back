{
  "name": "taiwan-brawl-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "ensure-kv": "node scripts/ensure-kv-namespaces.js",
    "test": "node --test",
    "assets:generate": "node upload.js",
    "kv:upload": "wrangler kv bulk put assets.json --binding=STATIC_ASSETS --remote",
    "game-catalog:sign": "node scripts/sign-game-catalog.mjs",
    "game-resource:sign": "node scripts/sign-game-resource.mjs",
    "game-release:package": "node scripts/package-game-release.mjs",
    "game-release:upload": "wrangler kv bulk put game-resource-release.json --binding=STATIC_ASSETS --remote",
    "commit:suggest": "bash tool/suggest_commit_message.sh",
    "commit:suggest:front": "bash tool/suggest_commit_message.sh --repo ../taiwan_brawl_front",
    "android:build": "bash tool/build_android.sh",
    "db:migration:rehearse": "node scripts/rehearse-game-data-migrations.mjs"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "wrangler": "^4.62.0"
  }
}
